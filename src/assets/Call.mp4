    <!-- HERO (SAME AS PARTNERS PAGE) -->
    <section class="pt-20 pb-8 bg-gray-100 fade-section show">
      <div class="max-w-5xl mx-auto px-6 relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl">
          <div class="slider relative w-full h-72 md:h-[450px]">
            <div class="slide absolute inset-0 transition-opacity duration-1000 opacity-0">
              <img src="./Call_files/building.avif" class="w-full h-full object-cover">
            </div>

            <div class="slide absolute inset-0 transition-opacity duration-1000 opacity-100">
              <img src="./Call_files/poornima 3.webp" class="w-full h-full object-cover">
            </div>

            <div class="slide absolute inset-0 transition-opacity duration-1000 opacity-0">
              <img src="./Call_files/footercover.webp" class="w-full h-full object-cover">
            </div>
          </div>
          <div class="absolute inset-0 bg-black/10"></div>
        </div>

        <div class="relative mt-8 w-fit mx-auto bg-white rounded-2xl shadow-lg px-12 py-5 text-center">
          <h2 class="text-3xl md:text-5xl font-bold text-primary mb-2">
            Call for Special Sessions
          </h2>
          <p class="text-gray-500">
            A forum for focused discussions on new topics or innovative
            applications
          </p>
          <div class="w-28 h-1 bg-yellow-500 mx-auto rounded-full"></div>
        </div>
      </div>
    </section>

    <!-- ORGANIZATION (WHITE → GRAY CARD) -->
    <section class="py-24 bg-white fade-section show">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-primary mb-12">
          Special Session Organization
        </h2>

        <!-- SOFT GRAY CARD -->
        <div class="card bg-gray-200 border border-gray-300 max-w-4xl mx-auto text-left text-gray-700 leading-relaxed">
          <p class="mb-4">
            Special Session Organization is highly encouraged. The goal of these
            special sessions is to provide a forum for focused discussions on
            new topics or innovative applications of established approaches.
          </p>

          <p>
            A special session could address a particular theme or consist of
            work done in some international project. Sessions of similar topics
            may be proposed; if needed, we will schedule them at different slots
            over the conference period.
          </p>
        </div>
      </div>
    </section>

    <!-- SPEAKERS (GRAY → WHITE CARD) -->
    <section class="py-24 bg-gray-200 fade-section show">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-primary mb-12">
          Selection of Invited Speakers
        </h2>

        <!-- WHITE CARD -->
        <div class="card bg-white border border-gray-200 max-w-4xl mx-auto text-left space-y-6">
          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 flex items-center justify-center bg-gray-300 text-gray-800 rounded-lg font-bold shrink-0">
              1
            </div>
            <p class="text-gray-700 leading-relaxed">
              Each special session will consist of a minimum of 10 papers,
              including invited papers and contribution papers related to the
              topic.
            </p>
          </div>

          <div class="flex gap-4 items-start">
            <div class="w-10 h-10 flex items-center justify-center bg-gray-300 text-gray-800 rounded-lg font-bold shrink-0">
              2
            </div>
            <p class="text-gray-700 leading-relaxed">
              A person may not present more than one invited paper (contact
              program chair for questions).
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- REQUIREMENTS + BANK (WHITE → GRAY CARDS) -->
    <section class="py-24 bg-white fade-section">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 text-left">
          <!-- ORGANIZER REQUIREMENTS -->
          <div class="card bg-gray-200 border border-gray-300">
            <h3 class="text-xl font-semibold mb-6 text-gray-800">
              Organizer Requirements
            </h3>

            <ul class="space-y-3 text-gray-700 leading-relaxed">
              <li>• Minimum of 10 papers per organized session.</li>
              <li>
                • Session organizers have full authority in soliciting and
                accepting papers with permission of the conference chair.
              </li>
              <li>• Limited to not more than 3 organizers per session.</li>
              <li>• Organizer can be designated as a chair or co-chair.</li>
            </ul>
          </div>

          <!-- BANK DETAILS -->
          <div class="card bg-gray-200 border border-gray-300">
            <h3 class="text-xl font-semibold mb-6 text-gray-800">
              RTGS / Bank Details
            </h3>

            <div class="space-y-3 text-gray-800 leading-relaxed">
              <p>
                <strong>Account Favouring:</strong> POORNIMA UNIVERSITY PART ONE
              </p>
              <p>
                <strong>Bank Detail:</strong> HDFC Bank Ltd. F-129 RIICO
                Industrial Area Sitapura, Jaipur
              </p>
              <p><strong>A/C No.:</strong> 50200067804063</p>
              <p><strong>IFSC:</strong> HDFC0003873</p>
              <p><strong>SWIFT CODE:</strong> HDFCINBBXXX</p>
            </div>

            <p class="text-sm text-gray-600 mt-6">
              Please use RTGS / NEFT for fee payment and share the transaction
              receipt with the organizing committee.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- DOWNLOAD (GRAY → WHITE CARD) -->
    <section class="py-24 pb-8 bg-gray-200 fade-section">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-bold text-primary mb-6">
          Download Proposal Template
        </h2>

        <p class="text-gray-700 mb-10">
          Use the official template to prepare and submit your special session
          proposal.
        </p>

        <!-- WHITE CARD (contrast with gray section) -->
        <div class="card bg-white border border-gray-300 flex flex-col items-center text-center">
          <!-- ICON -->
          <div class="w-16 h-16 flex items-center justify-center bg-gray-100 text-blue-700 rounded-full text-2xl mb-4">
            📄
          </div>

          <!-- TITLE -->
          <h3 class="text-xl font-semibold mb-2 text-gray-800">
            Special Session Proposal Template
          </h3>

          <!-- TEXT -->
          <p class="text-gray-600 mb-6">
            Download the official format for submission
          </p>

          <!-- BUTTON -->

          <a href="https://docs.google.com/document/d/1IWdt-XwiYXuJm_neaLfLHn9CrW1TIsmW/export?format=docx" download="Special-Session-Proposal-Template.docx" class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
            Download Now
          </a>
        </div>
      </div>
    </section>
    <!-- FOOTER -->
    <div id="footer-placeholder">

  
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Poornima Conference</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          Helvetica,
          sans-serif;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      /* demo content to show footer placement naturally */
      .demo-content {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
        text-align: center;
        background: linear-gradient(145deg, #f1f5f9 0%, #eef2ff 100%);
      }
      .demo-content h2 {
        font-size: 1.8rem;
        font-weight: 500;
        color: #0f172a;
        letter-spacing: -0.02em;
      }
      .demo-content p {
        color: #334155;
        margin-top: 0.75rem;
        max-width: 500px;
      }

      /* ---------- FOOTER STYLES (exactly as per image) ---------- */
      .footer {
        background: #0b1120; /* deep navy/slate, elegant for conferences */
        color: #e2e8f0;
        width: 100%;
        border-top: 1px solid rgba(71, 85, 105, 0.4);
        font-weight: 400;
      }

      .footer-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 3rem 2rem 1.8rem 2rem;
      }

      /* main grid: brand column | navigation | website | organizers */
      .footer-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1fr;
        gap: 2rem 2rem;
        margin-bottom: 2.5rem;
      }

      /* brand & microsoft CMT block */
      .brand-name {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #ffffff 0%, #a5f3fc 100%);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        margin-bottom: 1.1rem;
        display: inline-block;
      }

      .brand-description {
        font-size: 0.9rem;
        line-height: 1.55;
        color: #cbd5e6;
        margin-top: 0.5rem;
      }

      .brand-description p {
        margin-bottom: 0.75rem;
      }

      .brand-description .cmt-highlight {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.85rem;
        color: #b9c8ff;
        border-left: 2px solid #3b82f6;
        padding-left: 0.75rem;
        margin-top: 0.75rem;
      }

      /* navigation columns general */
      .footer-nav h3,
      .footer-website h3,
      .footer-organizers h3 {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: #f1f5f9;
        margin-bottom: 1.25rem;
        position: relative;
        display: inline-block;
      }

      .footer-nav h3:after,
      .footer-website h3:after,
      .footer-organizers h3:after {
        content: "";
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 32px;
        height: 2px;
        background: #3b82f6;
        border-radius: 4px;
      }

      .footer-nav ul,
      .footer-website ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      .footer-nav li a,
      .footer-website li a {
        text-decoration: none;
        color: #cbd5e6;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        display: inline-block;
        position: relative;
      }

      .footer-nav li a:hover,
      .footer-website li a:hover {
        color: white;
        transform: translateX(4px);
      }

      /* register button */
      .register-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #0f172a;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.7rem 1.6rem;
        border-radius: 40px;
        text-decoration: none;
        transition: all 0.25s ease;
        margin-top: 0.25rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
      }

      .register-btn:hover {
        background: #e2e8f0;
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
        border-color: #94a3b8;
        color: #020617;
      }

      .register-btn:active {
        transform: translateY(1px);
      }

      /* bottom bar (copyright + dev credit) */
      .footer-bottom {
        border-top: 1px solid rgba(71, 85, 105, 0.5);
        padding-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: 0.8rem;
        color: #94a3b8;
      }

      .copyright {
        letter-spacing: 0.2px;
      }

      .developer-credit {
        font-weight: 400;
        background: rgba(255, 255, 255, 0.03);
        padding: 0.3rem 0.9rem;
        border-radius: 40px;
        backdrop-filter: blur(2px);
      }

      .developer-credit a {
        text-decoration: none;
        color: #a5b4fc;
        font-weight: 500;
        transition: color 0.2s;
      }

      .developer-credit a:hover {
        color: white;
        text-decoration: underline;
      }

      /* extra microsoft subtle note (optional but clean) */
      .msft-note {
        font-size: 0.7rem;
        color: #7e8aa8;
        margin-top: 0.5rem;
      }

      /* responsiveness: tablet & mobile */
      @media (max-width: 900px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: 2rem 1.8rem;
        }
        .footer-container {
          padding: 2.5rem 1.5rem 1.5rem;
        }
        .brand-name {
          font-size: 1.8rem;
        }
      }

      @media (max-width: 580px) {
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
          text-align: left;
        }
        .footer-nav h3:after,
        .footer-website h3:after,
        .footer-organizers h3:after {
          left: 0;
        }
        .footer-bottom {
          flex-direction: column;
          text-align: center;
          justify-content: center;
        }
        .register-btn {
          justify-content: center;
        }
        .brand-description .cmt-highlight {
          border-left-width: 2px;
        }
      }

      /* additional hover & focus accessibility */
      a:focus-visible,
      .register-btn:focus-visible {
        outline: 2px solid #60a5fa;
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* small design: smooth scroll */
      html {
        scroll-behavior: smooth;
      }

/* ================= POPUP CSS ================= */

  #conferencePopup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    display: none;
    z-index: 9999;
    overflow-y: auto; /* scroll on mobile */
    padding: 20px;
  }

  #conferencePopup.show {
    display: flex;
    align-items: flex-start; /* important */
    justify-content: center;
  }

  /* Modal box */
  #conferencePopup .popup-box {
    background: #ffffff;
    width: 100%;
    max-width: 800px; /* smaller on desktop */
    border-radius: 18px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
    margin-top: 40px;
    margin-bottom: 40px;
    overflow: hidden;
  }

  /* Desktop center perfectly */
  @media (min-width: 768px) {
    #conferencePopup.show {
      align-items: center; /* vertical center only on desktop */
    }

    #conferencePopup .popup-box {
      margin: 0;
    }
  }

    </style>
  
  
    <!-- demo content to simulate real website context (not part of footer) -->
    <main class="demo-content">
      <div>
        <h2>International Conference 2026</h2>
        <p>
          Innovation, Research &amp; Future Technologies | Submit your paper now
        </p>
      </div>
    </main>

    <!-- FOOTER SECTION - exactly as described in the image -->
    <footer class="footer show-footer">
      <div class="footer-container">
        <!-- main 4 column layout (brand, navigation, website, organizers) -->
        <div class="footer-grid">
          <!-- Left column: POORNIMA brand + Microsoft CMT service description -->
          <div class="footer-brand">
            <div class="brand-name">
              <img src="./Call_files/PU_Logo.png" alt="PU Logo" style="
                  background: #fff;
                  border-radius: 12px;
                  padding: 8px;
                  max-width: 180px;
                  width: 100%;
                  height: auto;
                  display: block;
                ">
            </div>
            <div class="brand-description">
              <p>
                The Microsoft CMT service was used for managing the
                peer-reviewing process for this conference. This service was
                provided for free by Microsoft and they bore all expenses,
                including costs for Azure cloud services as well as for software
                development and support.
              </p>
              <!-- subtle microsoft nuance just for style -->
              <span class="cmt-highlight">✓ Conference Management Toolkit (CMT) by Microsoft</span>
            </div>
          </div>

          <!-- Navigation column: exactly matches "About, Committees, Call for Paper, Speakers, Partners, Contact" -->
          <div class="footer-nav">
            <h3>NAVIGATION</h3>
            <ul>
              <li><a href="https://iciset.poornima.edu.in/call-for-special-session#about">About</a></li>
              <li><a href="https://iciset.poornima.edu.in/call-for-special-session#committees">Committees</a></li>
              <li><a href="https://iciset.poornima.edu.in/call-for-special-session#call-for-paper">Call for Paper</a></li>
              <li><a href="https://iciset.poornima.edu.in/call-for-special-session#speakers">Speakers</a></li>
              <li><a href="https://iciset.poornima.edu.in/call-for-special-session#partners">Partners</a></li>
              <li><a href="https://iciset.poornima.edu.in/call-for-special-session#contact">Contact</a></li>
            </ul>
          </div>

          <!-- WEBSITE column: Sitemap, Report, Developer (exact match) -->
          <div class="footer-website">
